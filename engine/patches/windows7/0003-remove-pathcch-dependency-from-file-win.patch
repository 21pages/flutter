+static std::unique_ptr<wchar_t[]> CopyPathWithPrefix(
+    const wchar_t* prefix,
+    const wchar_t* path) {
+  size_t result_length = wcslen(prefix) + wcslen(path) + 1;
+  auto result = std::make_unique<wchar_t[]>(result_length);
+  wcscpy_s(result.get(), result_length, prefix);
+  wcscat_s(result.get(), result_length, path);
+  return result;
+}
