@@ -39,6 +40,21 @@ DEFINE_FLAG(int,
 // TODO(zra): Remove once VM shuts down cleanly.
 bool private_flag_windows_run_tls_destructors = true;
 
+typedef VOID(WINAPI* GetCurrentThreadStackLimitsFunc)(PULONG_PTR low_limit,
+                                                      PULONG_PTR high_limit);
+
+static GetCurrentThreadStackLimitsFunc GetCurrentThreadStackLimitsDynamic() {
+  static GetCurrentThreadStackLimitsFunc func = [] {
+    HMODULE kernel32 = ::GetModuleHandleW(L"kernel32.dll");
+    if (kernel32 == nullptr) {
+      return static_cast<GetCurrentThreadStackLimitsFunc>(nullptr);
+    }
+    return reinterpret_cast<GetCurrentThreadStackLimitsFunc>(
+        ::GetProcAddress(kernel32, "GetCurrentThreadStackLimits"));
+  }();
+  return func;
+}
