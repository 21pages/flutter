 bool OSThread::GetCurrentStackBounds(uword* lower, uword* upper) {
-  // PULONG and uword are sometimes different fundamental types.
-  ::GetCurrentThreadStackLimits(reinterpret_cast<PULONG_PTR>(lower),
-                                reinterpret_cast<PULONG_PTR>(upper));
-  return true;
+  auto get_current_thread_stack_limits = GetCurrentThreadStackLimitsDynamic();
+  if (get_current_thread_stack_limits != nullptr) {
+    // PULONG and uword are sometimes different fundamental types.
+    get_current_thread_stack_limits(reinterpret_cast<PULONG_PTR>(lower),
+                                    reinterpret_cast<PULONG_PTR>(upper));
+    return true;
+  }
+
+  // GetCurrentThreadStackLimits is not available on Windows 7. The NT_TIB is
+  // the first field of the TEB and has provided the same stack bounds since NT.
+  PNT_TIB tib = reinterpret_cast<PNT_TIB>(NtCurrentTeb());
+  *lower = reinterpret_cast<uword>(tib->StackLimit);
+  *upper = reinterpret_cast<uword>(tib->StackBase);
+  return true;
 }
 
